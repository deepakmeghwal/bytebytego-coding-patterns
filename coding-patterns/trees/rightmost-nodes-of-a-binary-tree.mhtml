-0.25em"></span><span class=3D"mord mathnormal" style=3D"margin-right:0.027=
78em">O</span><span class=3D"mopen">(</span><span class=3D"mord mathnormal"=
>n</span><span class=3D"mclose">)</span></span></span></span>, where <span =
class=3D"katex"><span class=3D"katex-mathml"><math xmlns=3D"http://www.w3.o=
rg/1998/Math/MathML"><semantics><mrow><mi>n</mi></mrow><annotation encoding=
=3D"application/x-tex">n</annotation></semantics></math></span><span class=
=3D"katex-html" aria-hidden=3D"true"><span class=3D"base"><span class=3D"st=
rut" style=3D"height:0.4306em"></span><span class=3D"mord mathnormal">n</sp=
