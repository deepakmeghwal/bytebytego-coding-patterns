up><mi>n</mi><mn>2</mn></msup><mo stretchy=3D"false">)</mo></mrow><annotati=
on encoding=3D"application/x-tex">O(n^2)</annotation></semantics></math></s=
pan><span class=3D"katex-html" aria-hidden=3D"true"><span class=3D"base"><s=
